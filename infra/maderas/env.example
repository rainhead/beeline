# Template for ~/.config/beeline/env on maderas (chmod 600).
# The private-store key must never live beside the database files or enter
# the repo (ADR 0003) — this file is its home on the host.
BEELINE_ENV=sandbox
PORT=3054
BEELINE_ORIGIN=https://beeline.beeatlas.net
# openssl rand -hex 32 — losing this key is losing the private store.
BEELINE_PRIVATE_DB_KEY=
# The sandbox's own iNat OAuth app (callback https://beeline.beeatlas.net/auth/inat/callback).
INAT_CLIENT_ID=
INAT_CLIENT_SECRET=
# Nightly sync: iNat project ids and sliding window.
BEELINE_SYNC_PROJECTS=18521,166376,99706
BEELINE_SYNC_DAYS=14
