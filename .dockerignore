# The build context must not carry the store or its inputs: data/ alone is
# ~4.9 GB (4.6 GB of DEM tiles) and beeline.duckdb is 266 MB. Everything the
# app needs at runtime that lives in data/ arrives on the Fly volume instead,
# mounted at /app/data (fly.toml, at the repo root).
data/
*.duckdb
*.duckdb.wal
*.duckdb.pre-migrate

node_modules/
dist/

.git/
.github/
.beads/
.dolt/
*.db
.beads-credential-key

# Reference material saved from shared artifacts, not source.
orcasound/

# Nothing under test/ or docs/ is read at runtime.
test/
docs/
*.md
!README.md
