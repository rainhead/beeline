# User systemd unit for the Beeline sandbox (~/.config/systemd/user/) on
# maderas — TEMPORARY hosting, revisit at cutover. One process, ever: it
# owns beeline.duckdb (ADR 0005); a deploy is a restart.
[Unit]
Description=Beeline web app (sandbox; maderas hosting is temporary)
After=network-online.target

[Service]
WorkingDirectory=%h/dev/beeline
# Secrets and settings live outside the repo and the databases (ADR 0003).
EnvironmentFile=%h/.config/beeline/env
# systemd's user PATH has neither pnpm (~/.local/bin) nor node (nvm, which
# login shells don't load either) — provide both explicitly; the node
# version follows nvm's default alias (set to the .nvmrc major).
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c '. "$HOME/.nvm/nvm.sh" && exec pnpm app:start'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
